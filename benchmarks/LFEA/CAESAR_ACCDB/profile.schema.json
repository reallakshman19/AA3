{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "caesar-accdb-benchmark-profile/v1",
  "title": "CAESAR ACCDB benchmark profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profileId",
    "benchmarkId",
    "installationTemperature",
    "caseSelection",
    "nodeSelection",
    "resultFamilies",
    "conventions",
    "equilibriumTolerance",
    "tolerances"
  ],
  "properties": {
    "schema": { "const": "caesar-accdb-benchmark-profile/v1" },
    "profileId": { "type": "string", "minLength": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "installationTemperature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["C", "F", "K"] }
      }
    },
    "caseSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "cases"],
          "properties": {
            "mode": { "const": "ALL_AVAILABLE" },
            "cases": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "cases"],
          "properties": {
            "mode": { "const": "EXPLICIT" },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["caseId", "lcaseNumber"],
                "properties": {
                  "caseId": { "type": "string", "minLength": 1 },
                  "lcaseNumber": { "type": "integer" }
                }
              }
            }
          }
        }
      ]
    },
    "nodeSelection": {
      "enum": ["ALL_OUTPUT_NODES", "INPUT_ENDPOINT_NODES"]
    },
    "resultFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DISPLACEMENT",
          "RESTRAINT_REACTION",
          "GLOBAL_ELEMENT_END_ACTION",
          "NODAL_EQUILIBRIUM"
        ]
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restraintReaction"],
      "properties": {
        "restraintReaction": {
          "enum": ["CAESAR_FORCE_ON_SUPPORT", "FORCE_ON_STRUCTURE"]
        }
      }
    },
    "equilibriumTolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forceN", "momentNm"],
      "properties": {
        "forceN": { "type": "number", "minimum": 0 },
        "momentNm": { "type": "number", "minimum": 0 }
      }
    },
    "tolerances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["absolute", "relative", "scaleFloor"],
        "properties": {
          "absolute": { "type": "number", "minimum": 0 },
          "relative": { "type": "number", "minimum": 0 },
          "scaleFloor": { "type": "number", "minimum": 0 }
        }
      }
    },
    "linearSolve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thermalExpansionCoefficientPerKelvin",
        "gravityAcceleration",
        "bourdonPressureEffects",
        "directionalB31JTeeFlexibility",
        "teeNominalDiameterRelativeTolerance",
        "reducerCondensation"
      ],
      "properties": {
        "thermalExpansionCoefficientPerKelvin": { "type": "number", "exclusiveMinimum": 0 },
        "gravityAcceleration": { "type": "number", "exclusiveMinimum": 0 },
        "bourdonPressureEffects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source"],
          "properties": {
            "mode": {
              "enum": ["DISABLED", "TRANSLATION_ONLY", "TRANSLATION_AND_ROTATION"]
            },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "directionalB31JTeeFlexibility": { "type": "boolean" },
        "teeNominalDiameterRelativeTolerance": { "type": "number", "minimum": 0, "maximum": 0.01 },
        "reducerCondensation": { "type": "boolean" }
      }
    }
  }
}
