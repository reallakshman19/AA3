      "sigmaZ": "2mu*(-theta/3)+K*theta_bar",
      "tauXY": "mu*gamma_xy"
    },
    "energy": "U=integral_A(t*mu*e_dev:e_dev dA)+0.5*t*A*K*theta_bar^2"
  },
