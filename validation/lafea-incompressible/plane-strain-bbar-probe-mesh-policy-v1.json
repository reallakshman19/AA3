{
  "schema": "lafea-plane-strain-bbar-probe-mesh-policy/v1",
  "programmeId": "LAFEA3-PS-BBAR-001",
  "definitionState": "FROZEN_BEFORE_PRODUCTION_OBSERVATION",
  "productionOutputUsedToChooseDefinition": false,
  "purpose": "Keep frozen physical probes strictly inside one T6/Q8 element while preserving exact local factor-two h refinement.",
  "radialAxis": {
    "targetPhase": 0.35,
    "protectedProbeRadii": [30, 60, 90],
    "cellWidthEqualsTargetH": true
  },
  "angularAxis": {
    "targetPhase": 0.65,
    "protectedProbeAnglesDegrees": [30],
    "localTargetLengthToAngleRule": "deltaThetaTarget=h/meanRadius",
    "cellWidthEqualsTargetDeltaTheta": true
  },
  "t6DiagonalAvoidance": {
    "cellDiagonalConvention": "LOWER_INNER_TO_UPPER_OUTER",
    "requireDifferentRadialAndAngularProbePhases": true,
    "minimumPhaseSeparation": 0.2,
    "mappingAmbiguityAllowed": false
  },
  "boundaryPolicy": {
    "innerOuterCircularBoundariesExact": true,
    "symmetryAxesExact": true,
    "probeMustNotLieOnElementBoundary": true
  },
  "refinement": {
    "ratio": 2,
    "localProbeCellWidthContraction": "EXACT_FACTOR_TWO_PER_LEVEL"
  },
  "authority": {
    "benchmarkQualified": false,
    "releaseAuthorityGranted": false
  }
}
