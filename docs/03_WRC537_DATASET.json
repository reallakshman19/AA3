  "equations": [
    {"id": "EQ_GENERAL", "human": "σ = Ni/T ± 6Mi/T²", "machine": "Ni / T +/- 6 * Mi / (T**2)", "source": {"section": "2"}},
    {"id": "EQ_RADIAL_MEMBRANE", "human": "σ_m = (Nφ/P)(P/T)", "machine": "coeff_Nphi * P / T", "source": {"section": "3.3.1", "equation": "Eq. 6"}},
    {"id": "EQ_RADIAL_BENDING", "human": "σ_b = (Mφ/P)(6P/T²)", "machine": "coeff_Mphi * 6 * P / (T**2)", "source": {"section": "3.3.1", "equation": "Eq. 7"}},
    {"id": "EQ_MOMENT_MEMBRANE", "human": "σ_m = (Nφ√(RmT)/M)(M/(T√(RmT)))", "machine": "coeff_Nphi * M / (T * sqrt(Rm * T))", "source": {"section": "3.3.2", "equation": "Eq. 12"}},
    {"id": "EQ_MOMENT_BENDING", "human": "σ_b = (Mφ√(RmT)/M)(6M/(T²√(RmT)))", "machine": "coeff_Mphi * 6 * M / (T**2 * sqrt(Rm * T))", "source": {"section": "3.3.2", "equation": "Eq. 13"}},
    {"id": "EQ_TORSION", "human": "τ = Mt/(2πr₀²T)", "machine": "Mt / (2 * pi * r0**2 * T)", "source": {"section": "3.3.3", "equation": "Eq. 18"}},
    {"id": "EQ_SHEAR_ROUND", "human": "τ = V sinθ/(πr₀T)", "machine": "V * sin(theta) / (pi * r0 * T)", "source": {"section": "3.3.4", "equation": "Eq. 19"}},
    {"id": "EQ_SHEAR_SQUARE", "human": "τ = V/(πC₁C₂)", "machine": "V / (pi * C1 * C2)", "source": {"section": "3.3.4", "equation": "Eq. 20"}},
    {"id": "EQ_CURVEFIT_Y", "human": "Y = a + b·U + c·U² + d·U³ + e·U⁴ + f·U⁵ + g·U⁶ + h·U⁷ + i·U⁸ + j·U⁹", "machine": "a + b*U + c*U**2 + d*U**3 + e*U**4 + f*U**5 + g*U**6 + h*U**7 + i*U**8 + j*U**9", "source": {"section": "All SP/SM tables"}},
    {"id": "EQ_KN", "human": "Kn = 1 + (0.65/(r/(2T))^5.6)", "machine": "1 + 0.65 / (r / (2*T))**5.6", "source": {"section": "Appendix B", "equation": "B.3", "page": "176"}},
    {"id": "EQ_KB_HEYWOOD", "human": "Kb = 1 + (0.85/(r/(2T))^10.75)", "machine": "1 + 0.85 / (r / (2*T))**10.75", "source": {"section": "Appendix B", "equation": "B.4", "page": "176"}},
    {"id": "EQ_KB_PETERSON", "human": "Kb = 1 + (0.80/(r/(2T))^9.4)", "machine": "1 + 0.80 / (r / (2*T))**9.4", "source": {"section": "Appendix B", "equation": "B.5", "page": "176"}},
    {"id": "EQ_STRESS_INTENSITY", "human": "Si1 = √(0.5[(σx+σy)+√((σx-σy)²+4τ²)]), etc., S=max(Si1,Si2,Si3)", "machine": "sqrt(0.5*((sigx+sigy)+sqrt((sigx-sigy)**2+4*tau**2)))", "source": {"section": "Table 3/5"}}
  ],
